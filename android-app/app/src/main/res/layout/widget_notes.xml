<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/notes_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:background="@drawable/widget_bg0">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<TextView android:id="@+id/notes_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Notas internas" android:textStyle="bold" android:textSize="16sp"/>
<ImageView android:id="@+id/notes_refresh" android:layout_width="40dp" android:layout_height="36dp" android:padding="9dp" android:src="@drawable/ic_widget_refresh" android:contentDescription="Atualizar"/>
<ImageView android:id="@+id/notes_add" android:layout_width="40dp" android:layout_height="36dp" android:padding="9dp" android:src="@drawable/ic_widget_plus" android:contentDescription="Nova nota ou tarefa"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<TextView android:id="@+id/notes_all" android:layout_width="0dp" android:layout_weight="1" android:layout_height="34dp" android:gravity="center" android:text="Todas" android:textSize="12sp" android:layout_margin="2dp"/><TextView android:id="@+id/notes_note" android:layout_width="0dp" android:layout_weight="1" android:layout_height="34dp" android:gravity="center" android:text="Notas" android:textSize="12sp" android:layout_margin="2dp"/><TextView android:id="@+id/notes_task" android:layout_width="0dp" android:layout_weight="1" android:layout_height="34dp" android:gravity="center" android:text="Tarefas" android:textSize="12sp" android:layout_margin="2dp"/>
</LinearLayout>
<TextView android:id="@+id/notes_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:gravity="center"/>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><ListView android:id="@+id/notes_rows" android:layout_width="match_parent" android:layout_height="match_parent" android:dividerHeight="4dp" android:divider="@android:color/transparent"/><TextView android:id="@+id/notes_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="Sem notas ou tarefas" android:textSize="13sp"/></FrameLayout>
</LinearLayout>